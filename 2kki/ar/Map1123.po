#. ID 14, Page 1, Line 4, Pos (27,190)
#. Contains choice at line 2 (3 options)
msgid "\\>自動販売機イベント\\$"
msgstr ""

#. ID 14, Page 1, Line 5, Pos (27,190)
#. Choice (3 options, embedded in a message)
msgid ""
"\\>デフォルト設定で買う\n"
"\\>価格と商品を固定させる\n"
"\\>やっぱ買わない"
msgstr ""

#. ID 14, Page 1, Line 7, Pos (27,190)
msgid ""
"\\>◆イベントの呼び出しで、\n"
"\\>　[0006:自販機EV]を呼び出せばＯＫです。"
msgstr ""

#. ID 14, Page 1, Line 11, Pos (27,190)
msgid ""
"\\>変数[0066:自販機：価格]に数値を入れて\n"
"\\>価格を固定させます。0だと100夢になります。"
msgstr ""

#. ID 14, Page 1, Line 14, Pos (27,190)
msgid ""
"\\>変数\\V[0067:自販機：商品設定]に数値を入れて\n"
"\\>商品を固定させます。0だとランダムになります。\n"
"\\>（※何番がどれかは自販機EVの内部参照）"
msgstr ""

#. ID 14, Page 1, Line 30, Pos (27,190)
msgid ""
"\\>自販機のイベントはコピペではなく、\n"
"\\>コモンイベントを呼び出すタイプに変更されました。\n"
"\n"
"\\>詳しくはコモンイベント[0006:自販機EV]を参照。"
msgstr ""

#. ID 14, Page 1, Line 34, Pos (27,190)
msgid ""
"\\>既に設置されていた自販機イベントも\n"
"\\>コモンイベントを呼び出すように改変してあります。"
msgstr ""

#. ID 16, Page 1, Line 2, Pos (27,189)
msgid "\\>共通で使うオブジェクトです"
msgstr ""

#. ID 16, Page 1, Line 3, Pos (27,189)
msgid "\\>自販機は、特別のことが無い限り統一しましょう。"
msgstr ""

#. ID 17, Page 1, Line 3, Pos (27,132)
#. ID 18, Page 1, Line 3, Pos (26,161)
#. ID 19, Page 1, Line 3, Pos (28,141)
#. ID 20, Page 1, Line 3, Pos (66,179)
#. ID 21, Page 1, Line 3, Pos (9,233)
msgid ""
"\\>作りかけの行き止まりなどは\n"
"\\>「工事中」の表示をすると\n"
"\\>プレイヤーに親切です。"
msgstr ""

#. ID 17, Page 1, Line 6, Pos (27,132)
#. ID 18, Page 1, Line 6, Pos (26,161)
#. ID 19, Page 1, Line 6, Pos (28,141)
#. ID 20, Page 1, Line 6, Pos (66,179)
#. ID 21, Page 1, Line 6, Pos (9,233)
msgid ""
"\\>エフェクトをすべて試してダメでした。\n"
"\\>という時はとってもガッカリします。"
msgstr ""

