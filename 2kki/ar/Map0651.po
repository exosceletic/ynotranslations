msgid ""
"\\>行く？\n"
"\\>行かない？"
msgstr ""

#. ID 6, Page 1, Line 1, Pos (15,1)
msgid ""
"「スターマン氏が実装させた収集要素を教えてやるが、\n"
"どうかね？」"
msgstr ""

#. ID 6, Page 1, Line 3, Pos (15,1)
#. Choice (4 options)
msgid ""
"\\>教えて！\n"
"\\>別にいい\n"
"\\>仮面の下ってどうなってんの？\n"
"\\>最近胡麻横丁で何が起きた？"
msgstr ""

#. ID 6, Page 1, Line 7, Pos (15,1)
msgid ""
"「・・・すまん。何言おうか忘れてしもうた。\n"
"本当にすまないのう」"
msgstr ""

#. ID 6, Page 1, Line 13, Pos (15,1)
msgid ""
"「終わりには様々な種類があるんじゃ。一巻の終わり\n"
"や学期の終わり、生命の終わり等がある。コレクショ\n"
"ンをしててもうあまり残りが無いということはそれも\n"
"終わりに近づくってことじゃ」"
msgstr ""

#. ID 6, Page 1, Line 19, Pos (15,1)
msgid "「夢の中の住人の印象はどうじゃった？」"
msgstr ""

#. ID 6, Page 1, Line 26, Pos (15,1)
msgid ""
"「胡麻横丁に繋がるアーチと同じ場所に階段がある。\n"
"その先にいる子はとてもかわいいんじゃよ」"
msgstr ""

#. ID 6, Page 1, Line 30, Pos (15,1)
msgid ""
"「あの子はたまに寝てる時があるんじゃよ。まぁ、そ\n"
"の気分のよってその子の行動が変わるから全部のパタ\n"
"ーン出来ればみておくれ」"
msgstr ""

#. ID 6, Page 1, Line 39, Pos (15,1)
msgid ""
"「可愛らしい名前の橋には風船の船が運航してるんじ\n"
"ゃよ。一度はそこに行ってみるがよいぞ」"
msgstr ""

#. ID 6, Page 1, Line 43, Pos (15,1)
msgid "「月の湖も綺麗じゃったろう？」"
msgstr ""

#. ID 6, Page 1, Line 50, Pos (15,1)
msgid ""
"「あそこの団員は最終的には口にするほどおそまじい\n"
"結末になるんじゃよ・・・お主も気を付けた方が良い\n"
"かもしれん」"
msgstr ""

#. ID 6, Page 1, Line 55, Pos (15,1)
msgid ""
"「悲惨じゃったろう、私もあんな結末になるとは想像\n"
"もつかなかったわい」"
msgstr ""

#. ID 6, Page 1, Line 63, Pos (15,1)
msgid ""
"「あの神殿は暖かいのじゃ。もしかするとそこにいる\n"
"生物がコントロールしてるかもしれん」"
msgstr ""

#. ID 6, Page 1, Line 67, Pos (15,1)
msgid ""
"「そいつがそこの温泉をコントロールしてるのじゃ。\n"
"有効成分が効いててあらゆる症状を直すらしいぞ」"
msgstr ""

#. ID 6, Page 1, Line 75, Pos (15,1)
msgid ""
"「とある建物の中のとある家、そこに謎の人物がおっ\n"
"てな、そいつは只者ではない。何かしらエフェクトを\n"
"試してみるのがよいぞ」"
msgstr ""

#. ID 6, Page 1, Line 80, Pos (15,1)
msgid ""
"「どうやらあいつは天使みたいなんじゃよ。何故なら\n"
"ば羽が生えておるからのぅ」"
msgstr ""

#. ID 6, Page 1, Line 88, Pos (15,1)
msgid ""
"「一般人は立ち入り禁止の場所、そう、そこの店で生\n"
"産している工場がその先にあるんじゃ。気になるじゃ\n"
"ろう？」"
msgstr ""

#. ID 6, Page 1, Line 93, Pos (15,1)
msgid ""
"「こんな感じで服が作られるんだ・・・と思ったか\n"
"ね？以外じゃったろう？」"
msgstr ""

#. ID 6, Page 1, Line 103, Pos (15,1)
msgid ""
"「みんな仮面と一体化してしまったのじゃよ！だからもう\n"
"見ることはないじゃろう」"
msgstr ""

#. ID 6, Page 1, Line 105, Pos (15,1)
#. Choice (3 options)
msgid ""
"\\>マジで！？\n"
"\\>えっ、嘘でしょ\n"
"\\>そうですか・・・"
msgstr ""

#. ID 6, Page 1, Line 107, Pos (15,1)
msgid ""
"「そんなん嘘じゃよｗｗだが仮面の下は絶対に\n"
"見せないぞよ・・・？」"
msgstr ""

#. ID 6, Page 1, Line 111, Pos (15,1)
msgid ""
"「・・・バレたか！お主はなかなかやるのう。だが仮面\n"
"の下は見せられないぞよ！」"
msgstr ""

#. ID 6, Page 1, Line 115, Pos (15,1)
msgid ""
"「まぁ、嘘じゃがな。だが、仮面の下は絶対に\n"
"見せられないぞよ？」"
msgstr ""

#. ID 6, Page 1, Line 121, Pos (15,1)
msgid ""
"「もうお主の自由にして構わん。スターマン氏自身\n"
"著作権放棄しとったからのう」"
msgstr ""

#. ID 6, Page 1, Line 125, Pos (15,1)
msgid "「なら無暗に話しかけないで」"
msgstr ""

