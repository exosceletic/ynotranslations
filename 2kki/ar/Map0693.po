#. ID 1, Page 1, Line 1, Pos (1,2)
msgid ""
"いわゆるデバッグルーム\n"
"もう１つの備忘録\n"
"あと、忘れそうな仕様とか書き留めたい"
msgstr ""

#. ID 1, Page 1, Line 4, Pos (1,2)
msgid "次の更新で出すものとか置いとくと便利だねこれ"
msgstr ""

#. ID 2, Page 1, Line 1, Pos (2,2)
msgid "inks→祈願叶捧"
msgstr ""

#. ID 2, Page 1, Line 2, Pos (2,2)
msgid ""
"蛍で祈り(echrra)\n"
"彼岸花で願い(gagis)\n"
"ハザマで叶い(hymme)\n"
"星座で捧げた(noes)"
msgstr ""

#. ID 3, Page 1, Line 1, Pos (4,2)
msgid ""
"inks旋律→ドレラソドレラソドファミファミドレ\n"
"祈りの旋律→シーラソファーミレミシシラシ\n"
"叶う旋律→ラミシドソ\n"
"捧ぐ旋律→ソシレファ"
msgstr ""

#. ID 3, Page 1, Line 5, Pos (4,2)
msgid ""
"祈りの旋律は流用してる音源多いので活用したい\n"
"ただ、一部他マップで使われてるのがネックかも\n"
"24系・444・21-1~3・7-1~3・kodou\n"
"24pfだけはinks旋律を含んでる"
msgstr ""

#. ID 3, Page 1, Line 9, Pos (4,2)
msgid "叶う旋律は13系と28、47、hibinega"
msgstr ""

#. ID 3, Page 1, Line 10, Pos (4,2)
msgid "捧ぐ旋律はまだ。そのうち作りたい"
msgstr ""

#. ID 3, Page 1, Line 11, Pos (4,2)
msgid ""
"願う旋律は存在しない\n"
"強いて言えば、34系のシファソレラかな"
msgstr ""

#. ID 4, Page 1, Line 1, Pos (5,2)
msgid ""
"NPC達の呼び名\n"
"私が呼びたいから呼ぶだけ\n"
"プレイヤーの思う呼び方でいいと思う"
msgstr ""

#. ID 4, Page 1, Line 4, Pos (5,2)
msgid ""
"ろうそく生物はケルツェって呼んでる\n"
"青い浮遊物体は魂って呼んでる\n"
"セレナーデやノクターンの子はイオナって呼んでる"
msgstr ""

#. ID 8, Page 1, Line 1, Pos (0,4)
msgid ""
"spelude\n"
"こんにちは\n"
"…おはよう、それともこんばんは？"
msgstr ""

#. ID 8, Page 1, Line 4, Pos (0,4)
msgid ""
"ともあれ、この場所まで来たという事は\n"
"エンディング４種を全て見たのですね\n"
"おめでとうございます"
msgstr ""

#. ID 8, Page 1, Line 8, Pos (0,4)
#. Choice (4 options)
msgid ""
"何作った人？\n"
"参加のきっかけは？\n"
"他にも何か話して\n"
"じゃあね"
msgstr ""

#. ID 8, Page 1, Line 10, Pos (0,4)
msgid ""
"一番メジャーなマップは\n"
"彼岸花、金平糖、星座あたりでしょうか\n"
"素材として提供されたものをよく使用してます"
msgstr ""

#. ID 8, Page 1, Line 14, Pos (0,4)
#. Choice (3 options)
msgid ""
"マップについてもっと話して\n"
"最初に戻る\n"
"じゃあね"
msgstr ""

#. ID 8, Page 1, Line 19, Pos (0,4)
msgid ""
"蛍の舞うあの世界へ行ったんですね。\n"
"あそこはBGMも含めて、自分でもお気に入りの世界です。\n"
"個人的におすすめなのは、雪の降っている時ですね。\n"
"雪と蛍…儚いもの同士が集まるの、良くないですか？"
msgstr ""

#. ID 8, Page 1, Line 25, Pos (0,4)
msgid ""
"絵本のような世界の中で、ピアニストが演奏している\n"
"部屋があります。そこの南側の壁を調べてみると…？"
msgstr ""

#. ID 8, Page 1, Line 34, Pos (0,4)
msgid ""
"自分と同じ姿の存在を突き落とす…\n"
"そんな夢の経験、ありません？\n"
"元々は自分で書いていたとある詩から着想を得た\n"
"世界なのですが、けっこう思い入れも深くなりました"
msgstr ""

#. ID 8, Page 1, Line 40, Pos (0,4)
msgid ""
"彼岸花の咲く世界を歩く、住人が１人\n"
"何度斬っても、別の世界を行き来すれば蘇る。\n"
"…本当に、そうでしょうか？"
msgstr ""

#. ID 8, Page 1, Line 50, Pos (0,4)
msgid ""
"金平糖の雨。子供の頃にはお菓子が降ってくるのを\n"
"空想したりなんかしてましたが、リアルというものを\n"
"考えてしまうと、痛そうとかべとべとになりそうとか\n"
"ついつい余計な事を考えてしまいます"
msgstr ""

#. ID 8, Page 1, Line 56, Pos (0,4)
msgid ""
"金平糖の降り注ぐ世界には、行ってみましたか？\n"
"道は直接つながっていませんが、実は奥まで\n"
"進む事ができます。\n"
"そこである事をすると…？"
msgstr ""

#. ID 8, Page 1, Line 67, Pos (0,4)
msgid ""
"青い水の中、緑の木。赤い水の中、紫の木…。\n"
"そんな世界に、辿り着いた事があるようですね。\n"
"実はこの世界、あるゲームから着想を得て作りました。\n"
"本当はもっと物を増やしたかったけどｺﾞﾆｮｺﾞﾆｮ…"
msgstr ""

#. ID 8, Page 1, Line 73, Pos (0,4)
msgid ""
"赤く鼓動が響く、細胞だらけの世界に、少し分かりに\n"
"くいですが、似たようで違うオブジェクトがあります。\n"
"もし既に訪れているのなら、何か見落としが\n"
"あるのかも…？"
msgstr ""

#. ID 8, Page 1, Line 84, Pos (0,4)
msgid ""
"うろつきとピアニストのセッションはもう見ましたか？\n"
"それとも、運悪くうろつきのソロ演奏?\n"
"いずれにせよ、あのマップでのイベントは、ずっと\n"
"私が実現してみたかったことでもあります。"
msgstr ""

#. ID 8, Page 1, Line 88, Pos (0,4)
msgid ""
"実は、絵本の世界でピアニストが弾いている曲も、\n"
"実際に弾けなくはない、という音数で作っています。\n"
"(１曲はどう頑張っても１人では弾けませんが…)\n"
"ちなみに、演奏をもう１度行ってみると…？"
msgstr ""

#. ID 8, Page 1, Line 94, Pos (0,4)
msgid ""
"多くの世界を巡ったあと、絵本の世界でとある事を\n"
"すると…？\n"
"たまには子供時代に戻るのも、いいかもしれませんね"
msgstr ""

#. ID 8, Page 1, Line 104, Pos (0,4)
msgid ""
"この文章を読んでいるということは、１度はあの\n"
"箱の世界へ飛んだのですね。\n"
"何が起きたのかまるでわからないまま目が覚める。\n"
"そんな理不尽さも、また夢の１つだと思ってます。"
msgstr ""

#. ID 8, Page 1, Line 110, Pos (0,4)
msgid ""
"青かったり、黄色っぽかったり、白黒だったり\n"
"そんな部屋に入った事、ありますか？\n"
"白黒だったら、彩ればいい…\n"
"その先に、１つの世界を実は作っています。"
msgstr ""

#. ID 8, Page 1, Line 124, Pos (0,4)
#. ID 8, Page 1, Line 152, Pos (0,4)
#. ID 10, Page 1, Line 18, Pos (2,4)
msgid "良い夢を"
msgstr ""

#. ID 8, Page 1, Line 129, Pos (0,4)
msgid ""
"図書館に本を置きたい、と思ったのが始まりです\n"
"あの頃は下のスペースもまだできてませんでした\n"
"いつの間にかマップやイベント作ってました\n"
"人生何があるかわからないものです"
msgstr ""

#. ID 8, Page 1, Line 137, Pos (0,4)
#. ID 8, Page 1, Line 144, Pos (0,4)
msgid ""
"更新の度に増やしていたけど、増えすぎて\n"
"会話イベントが長くなったので(メタい)\n"
"隣の子に話しかけてね"
msgstr ""

#. ID 8, Page 1, Line 140, Pos (0,4)
msgid ""
"あと、作った音楽の話は音職人のスペースで。\n"
"右の子と似たような姿がいると思います。"
msgstr ""

#. ID 8, Page 2, Line 1, Pos (0,4)
msgid ""
"spelude\n"
"こんにちは\\!\n"
"…\\S[15]誰か斬ったでしょ？"
msgstr ""

#. ID 8, Page 2, Line 4, Pos (0,4)
msgid ""
"逆さの彼岸花が咲く世界に行ったら、\n"
"またいらっしゃい"
msgstr ""

#. ID 8, Page 3, Line 1, Pos (0,4)
msgid ""
"spelude\n"
"こんにちは\\!\n"
"…なるほど、それも１つの選択ですね"
msgstr ""

#. ID 8, Page 4, Line 3, Pos (0,4)
msgid ""
"spelude\n"
"ねむたみのたみ\n"
"(-ω-)ｽﾔｧ"
msgstr ""

#. ID 8, Page 4, Line 9, Pos (0,4)
msgid ""
"spelude\n"
"目隠れってなんかいいよね、ミステリアスで"
msgstr ""

#. ID 8, Page 4, Line 14, Pos (0,4)
msgid ""
"spelude\n"
"見た夢が世界になって、世界はうろつきの夢になる\n"
"そうやって、記憶は継承されていくんだなって"
msgstr ""

#. ID 8, Page 4, Line 20, Pos (0,4)
msgid ""
"spelude\n"
"ゆめのなか　さまよいつづけ　そのはてで\n"
"あなたとうろは、ここでしぬのよ"
msgstr ""

#. ID 8, Page 4, Line 26, Pos (0,4)
msgid ""
"spelude\n"
"揚げると書いてフライ～♪"
msgstr ""

#. ID 8, Page 4, Line 31, Pos (0,4)
msgid ""
"spelude\n"
"更新する度にここのランダム台詞増やしてるんだわ\n"
"過去の自分との交換日記でも付けたら楽しいかなって"
msgstr ""

#. ID 8, Page 4, Line 37, Pos (0,4)
msgid ""
"spelude\n"
"感情って苦しいね\n"
"苦しくても頑張れる人間がすごい"
msgstr ""

#. ID 8, Page 4, Line 43, Pos (0,4)
msgid ""
"spelude\n"
"オモロイド\n"
"ああいう緊迫感に既視感あるなと思ったら\n"
"グレートンネルだった"
msgstr ""

#. ID 8, Page 4, Line 50, Pos (0,4)
msgid ""
"spelude\n"
"小夜曲と書いてセレナーデ\n"
"かっこいいし趣もある\n"
"ツユクサの花言葉でもあります"
msgstr ""

#. ID 8, Page 4, Line 57, Pos (0,4)
msgid ""
"spelude\n"
"ゆっくりしていってね！\n"
"ニコニコがまた盛り上がるといいなぁ\n"
"ゆめ２っきの動画はたまにエゴサしてます"
msgstr ""

#. ID 8, Page 4, Line 64, Pos (0,4)
msgid ""
"spelude\n"
"後悔がないかといえば嘘になる\n"
"けれどそれが最善であると知っているから\n"
"きっともう後悔していない"
msgstr ""

#. ID 8, Page 4, Line 71, Pos (0,4)
msgid ""
"spelude\n"
"74726…楽しむwikiでいう94nd0r4の検証動画を\n"
"見つけました。よくやるなぁ…。\n"
"あ、ちなみにver0.121cでイベント増やしました"
msgstr ""

#. ID 8, Page 4, Line 75, Pos (0,4)
msgid ""
"spelude\n"
"きっかけは1BPMっていう曲(？)のPV\n"
"ただ椅子があったり揺れたりしてるだけなのに、\n"
"音と見せ方でこんなに怖くできるんだ！って"
msgstr ""

#. ID 8, Page 4, Line 82, Pos (0,4)
msgid ""
"spelude\n"
"こっくりさん、こっくりさん\n"
"わたしはただのおきつねですよ"
msgstr ""

#. ID 8, Page 4, Line 85, Pos (0,4)
msgid ""
"spelude\n"
"九尾なのになぜ７回目で赤い空の崖へ飛ばされるのか\n"
"単純に回数がめんどくさかったのかもしれないし、\n"
"実は七尾なのかもしれない"
msgstr ""

#. ID 8, Page 4, Line 92, Pos (0,4)
msgid ""
"spelude\n"
"ver0.112で、私のマップの集大成みたいなのがようやく\n"
"作れました。いやー、こうして振り返るっていいね。\n"
"なんか他にも色々やりたかったけど、ひとまずこれで"
msgstr ""

#. ID 8, Page 4, Line 99, Pos (0,4)
msgid ""
"spelude\n"
"恨み、憎み、祟り、滅せよ\n"
"…私のマップが無価値だ、と断じるのは構いません\n"
"但し､それでマップが消えても､文句言わないで下さい"
msgstr ""

#. ID 9, Page 1, Line 1, Pos (1,4)
msgid ""
"spelude\n"
"こんにちは。\n"
"こっちの私は、その他のあれこれを話します。\n"
"ほとんど雑談というか、個人の呟きやポエムですね。"
msgstr ""

#. ID 9, Page 1, Line 6, Pos (1,4)
msgid ""
"0～14までの番号を入力してください。\n"
"それに応じて色々話します。"
msgstr ""

#. ID 9, Page 1, Line 10, Pos (1,4)
msgid ""
"私もマップも浮き沈みが激しいので、\n"
"マップの行き方がよく変わったりします\n"
"常に試行錯誤中"
msgstr ""

#. ID 9, Page 1, Line 16, Pos (1,4)
msgid ""
"運は偏りがち\n"
"夢見荘にUFOが何度も来たり、雨の森に雨が降ったり…\n"
"そのせいか、タコ風船には好かれていない模様"
msgstr ""

#. ID 9, Page 1, Line 22, Pos (1,4)
msgid ""
"私はその時によって言う事がころころ変わるので、\n"
"考察してもまた違う考察が思い浮かぶのです\n"
"もし私の作る世界に何かを見出したなら\n"
"それは貴方の導きだした答えです"
msgstr ""

#. ID 9, Page 1, Line 26, Pos (1,4)
msgid ""
"答えを私に求めたとしても、作った私は過去の私\n"
"私自身でさえそんな事を忘れ、変化し続けていく\n"
"貴方が忘れない限り、きっと消えた世界も\n"
"どこかで生き続けるのかもしれませんね"
msgstr ""

#. ID 9, Page 1, Line 33, Pos (1,4)
msgid ""
"なぜ人は記憶するのか、できるのか\n"
"夢は何のために存在するのか\n"
"とても興味深く、またそれがあるからこそ、\n"
"今の私たちがあるんでしょうね"
msgstr ""

#. ID 9, Page 1, Line 41, Pos (1,4)
msgid ""
"旋律を辿り終えたようですね。お疲れ様です\n"
"…なんのことか分からない？\n"
"黄色、赤、白、青の音符を辿ったでしょう？\n"
"その音の行く先は、新たな音の始まりなのです"
msgstr ""

#. ID 9, Page 1, Line 47, Pos (1,4)
msgid "音はいつも、記憶と共に"
msgstr ""

#. ID 9, Page 1, Line 53, Pos (1,4)
msgid ""
"最近の私はどうにも色々失ってるようです\n"
"何が好きで何が楽しくて何を目的に生きるのか\n"
"過去を見つめすぎて未来を失わないように\n"
"夢はいつでも希望を届けてくれます"
msgstr ""

#. ID 9, Page 1, Line 60, Pos (1,4)
msgid ""
"「好き」って言葉、実は苦手です\n"
"だって、「好き」と言ったら、多くの人は\n"
"「何が好き？どこが好き？」と聞いてくるんです\n"
"なんとなく気に入っている、それだけでいいのに"
msgstr ""

#. ID 9, Page 1, Line 64, Pos (1,4)
msgid ""
"だから私は「すこ」とか「いいと思う」とか、\n"
"あまり重くない好感の言葉が便利だな、と思うのです\n"
"そう、ゆめ２っきすこ"
msgstr ""

#. ID 9, Page 1, Line 70, Pos (1,4)
msgid ""
"そこに確かにあるのに、取り戻せないもどかしさ\n"
"失われた記憶に手が届きそうなのに\n"
"穢れたこの心では辿り着けない\n"
"願いを継げる誰かをずっと待ち続けて"
msgstr ""

#. ID 9, Page 1, Line 74, Pos (1,4)
msgid ""
"\n"
"…いつか、誰かの「好き」が\n"
"また見られる日が来ると信じて"
msgstr ""

#. ID 9, Page 1, Line 80, Pos (1,4)
msgid ""
"記憶の音、というのは\n"
"案外心にずっと残っているものです\n"
"ふと自分に寄り添ってくれる\n"
"そんな音楽が私は好みです"
msgstr ""

#. ID 9, Page 1, Line 87, Pos (1,4)
msgid ""
"本家のEDの音楽が心に残りすぎて、\n"
"無意識に自分の曲のコード進行に取り入れがち\n"
"ゆめ２っきで私が作っている曲も、\n"
"同じメロディーを転用できたりします"
msgstr ""

#. ID 9, Page 1, Line 94, Pos (1,4)
msgid ""
"誰が誰の世界って、意外と認識していないものです\n"
"楽しむwikiとか、他のマップとの類似を見て、\n"
"ああこの人だなって思ったりするわけです\n"
"そして気が付けば、貯金箱の金額が減っていく"
msgstr ""

#. ID 9, Page 1, Line 101, Pos (1,4)
msgid ""
"同じマップなのに、見え方が違えば思う所も\n"
"変わってくるんじゃないか？なんて思いながら。\n"
"同じような曲でも、ピアノアレンジと\n"
"オルゴールアレンジで雰囲気がガラリと変わるように"
msgstr ""

#. ID 9, Page 1, Line 108, Pos (1,4)
msgid ""
"私の作るBGMは特徴的なメロディが多いので、\n"
"あまりゆめにっきっぽくはないかもしれません\n"
"でも、夢の世界もその表現が多様化していますし、\n"
"１つぐらいはそういうのがあっても…だめ？"
msgstr ""

#. ID 9, Page 1, Line 115, Pos (1,4)
msgid ""
"ノスタルジア、という音楽ゲームが好きでした。\n"
"ピアノをモチーフとしていて、徐々に音を集めて\n"
"記憶を辿る、そんなお話。"
msgstr ""

#. ID 9, Page 1, Line 118, Pos (1,4)
msgid ""
"言葉のない、音と映像だけの物語。\n"
"人に多くを伝える事はできないけれど、\n"
"心に何らかの余韻を残していく。\n"
"そんなイベントを、私も作れたらいいな、と思うなど。"
msgstr ""

#. ID 9, Page 1, Line 125, Pos (1,4)
msgid ""
"星座となっている星には、色々な名前があります。\n"
"有名なのは、やはり夏の大三角でしょうか。\n"
"デネブ、ベガ、アルタイル\n"
"他にはおとめ座のスピカ、とか。"
msgstr ""

#. ID 9, Page 1, Line 129, Pos (1,4)
msgid ""
"ゆめ２っきの星座は架空のものもいくつかありますが、\n"
"もしもそれらの星に名前を付けるとしたら、\n"
"貴方はどんな名前を付けますか？"
msgstr ""

#. ID 9, Page 1, Line 135, Pos (1,4)
msgid ""
"14までって言ったでしょ？\n"
"これ以上を入力しても今は何も話せる事がないよ"
msgstr ""

#. ID 9, Page 1, Line 140, Pos (1,4)
msgid ""
"…と言いたいところですが、この数字をわざわざ\n"
"指定してくるということは、きっとあのマップを\n"
"ご存じなのでしょう。そう、94nd0r4と呼ばれる\n"
"あのマップを。"
msgstr ""

#. ID 9, Page 1, Line 144, Pos (1,4)
msgid ""
"こういうわけのわからないものがあった方が夢らしい\n"
"なんて思いながら作りました。プレイヤーの誰かが\n"
"偶然辿り着いて、困惑のまま起きてほしい、と。"
msgstr ""

#. ID 9, Page 1, Line 147, Pos (1,4)
msgid ""
"ただ、楽しむwikiに書かれてしまったので、さすがに\n"
"そういうコンセプトを維持するのが困難になりました。\n"
"なので、初めの１回は確実に行けるようにしました。\n"
"そして、今この瞬間も。"
msgstr ""

#. ID 10, Page 1, Line 2, Pos (2,4)
msgid ""
"spelude\n"
"こんにちは。\n"
"こっちの私は、作った音楽について喋ります。\n"
"ほぼ楽しむwikiのマップ名、キャラ名が出てきます。"
msgstr ""

#. ID 10, Page 1, Line 6, Pos (2,4)
msgid ""
"0～28までの番号を入力してください。\n"
"それに応じて色々話します。まだ訪れていないマップ\n"
"の場合は、話せない事もあるかもしれません。"
msgstr ""

#. ID 10, Page 1, Line 10, Pos (2,4)
