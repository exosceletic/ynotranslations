#. ID 2, Page 2, Line 1, Pos (3,2)
#. Choice (3 options)
msgid ""
"\\>ライフゲームってなに？\n"
"\\>おうち帰りたい\n"
"\\>なんでもないです"
msgstr ""

#. ID 2, Page 2, Line 3, Pos (3,2)
msgid ""
"\\>【ライフゲーム】\n"
"周囲８マスにある白いマスの数が、\n"
"「３なら自分も白く」「２ならそのまま」\n"
"「それ以外なら黒く」なるだけのゲームです。"
msgstr ""

#. ID 2, Page 2, Line 7, Pos (3,2)
msgid ""
"\\>【ライフゲーム】\n"
"本来は初期配置だけ決めて放置するものですが、\n"
"それだとやっぱり味気ないので、\n"
"自由に白くしたり黒くしたりできるようにしてます。"
msgstr ""

#. ID 2, Page 2, Line 11, Pos (3,2)
msgid ""
"\\>【ライフゲーム】\n"
"白黒のマスすべてが床に敷き詰められたキャラ扱いで、\n"
"当然ながらものすごく重いです。\n"
"マシンスペックによっては見れたもんじゃない、かも。"
msgstr ""

